{
  "_type": "discord-widget",
  "version": 2,
  "display_name": "GitHub Stats",
  "surfaces": {
    "widget_bottom": {
      "layout": "widget_bottom_stats",
      "components": {
        "stat_5": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "number",
              "value": "contributions"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Contributions"
            }
          }
        },
        "stat_3": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "number",
              "value": "repos"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Repos"
            }
          }
        },
        "stat_1": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "top_repo"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Top Repo"
            }
          }
        },
        "stat_2": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "number",
              "value": "forks"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Forks"
            }
          }
        },
        "stat_4": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "streak"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Best Streak"
            }
          }
        },
        "stat_6": {
          "fields": {
            "value": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "top_language"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Top Language"
            }
          }
        }
      }
    },
    "add_widget_preview": {
      "layout": "add_widget_preview_hero",
      "components": {
        "hero_image": {
          "fields": {
            "image": {
              "value_type": "application_asset",
              "presentation_type": "image",
              "value": "github-widget-preview-icon"
            }
          }
        }
      }
    },
    "widget_top": {
      "layout": "widget_top_contained",
      "components": {
        "subtitle_2": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "last_repo"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Latest Pushed"
            }
          }
        },
        "title": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "display_name"
            }
          }
        },
        "subtitle_1": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "joined"
            }
          }
        },
        "subtitle_3": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "last_active"
            },
            "label": {
              "value_type": "custom_string",
              "presentation_type": "text",
              "value": "Last Active"
            }
          }
        },
        "contained_image": {
          "fields": {
            "image": {
              "value_type": "data",
              "presentation_type": "image",
              "value": "avatar"
            }
          }
        }
      }
    },
    "mini_profile": {
      "layout": "mini_profile_hero_stat",
      "components": {
        "stat": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "display_name"
            }
          }
        },
        "hero_image": {
          "fields": {
            "image": {
              "value_type": "data",
              "presentation_type": "image",
              "value": "avatar"
            }
          }
        }
      }
    },
    "activity_accessory": {
      "layout": "activity_accessory_stat",
      "components": {
        "stat": {
          "fields": {
            "text": {
              "value_type": "data",
              "presentation_type": "text",
              "value": "display_name"
            }
          }
        }
      }
    }
  },
  "assets": {
    "github-widget-preview-icon": {
      "asset_type": "image",
      "content_type": "image/webp",
      "image": "data:image/webp;base64,"
    }
  }
}
